# Chemin absolu vers le répertoire de stockage des rapports de backtesting
BACKTEST_REPORTS_DIR=/mnt/venv_ext4/trading_automation_v2/reports

# Base de données PostgreSQL (ex: Supabase)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Sécurité Réseau - mTLS PostgreSQL (Optionnel)
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_CA=

# Cache distribué (ex: Upstash Redis ou Aiven for Valkey)
REDIS_URL=rediss://default:password@host:port
REDIS_USER=default
REDIS_PASSWORD=
REDIS_POOL_MAX=40

# Client secondaire optionnel pour le failover (Upstash)
REDIS_URL_2=
REDIS_USER_2=
REDIS_PASSWORD_2=

# Sécurité Réseau - mTLS Redis (Optionnel)
REDIS_SSL_CERT=
REDIS_SSL_KEY=
REDIS_SSL_CA=

# Configuration API Upstash optionnelle (requis uniquement pour la détection automatique de quotas Upstash)
REDIS_API=
REDIS_2_API=
UPSTASH_EMAIL=
UPSTASH_2_EMAIL=

# Chiffrement de la file d'attente SQLite (SQLCipher)
# Clé de chiffrement AES-256 (32 octets aléatoires recommandés)
SQLITE_ENCRYPTION_KEY=


# Configuration API Trading 212
T212_ENV=demo
# Variable spécifique pour l'ingesteur de prix (ex: demo pour l'ingesteur, live pour le trading)
T212_INGESTOR_ENV=demo
# Clés utilisées en mode DEMO (T212_ENV=demo)
T212_DEMO_API_KEY_ID=
T212_DEMO_API_SECRET=
# Clés utilisées en mode LIVE (T212_ENV=live)
T212_LIVE_API_KEY_ID=
T212_LIVE_API_SECRET=

# Activer le routage réel des ordres sur le compte Démo en Paper Trading
T212_PAPER_ROUTING_ENABLED=true

# Configuration API Bybit
BYBIT_ENV=demo
# Clés utilisées en mode DEMO (BYBIT_ENV=demo/testnet)
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
# Clés utilisées en mode LIVE (BYBIT_ENV=live)
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=

# Authentification du Dashboard Paper Trading
PAPER_TRADER_USER=admin
PAPER_TRADER_PASSWORD=

# Secret HMAC pour la signature des tokens de session (≥32 bytes)
# Générer via: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=

# Pipeline de Logging SIEM / ELK
# Chemin vers le fichier de logs d'audit JSON (Ex: /var/log/trading_audit.log)
TRADING_AUDIT_LOG_PATH=./trading_audit.log
