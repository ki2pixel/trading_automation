# Chemin absolu vers le répertoire de stockage des rapports de backtesting
BACKTEST_REPORTS_DIR=/mnt/venv_ext4/trading_automation_v2/reports

# Base de données PostgreSQL (ex: Supabase)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Cache distribué (ex: Upstash Redis ou Aiven for Valkey)
REDIS_URL=rediss://default:password@host:port
REDIS_POOL_MAX=40

# Client secondaire optionnel pour le failover
REDIS_URL_2=

# Configuration API Upstash optionnelle (requis uniquement pour la détection automatique de quotas Upstash)
REDIS_API=
REDIS_2_API=
UPSTASH_EMAIL=
UPSTASH_2_EMAIL=

# Authentification du Dashboard Paper Trading
PAPER_TRADER_USER=admin
PAPER_TRADER_PASSWORD=

# Secret HMAC pour la signature des tokens de session (≥32 bytes)
# Générer via: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=

